# Postgres. Use DATABASE_URL, or the DB_* variables below.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=pizza
DB_SSLMODE=require

# Required when GIN_MODE=release (the Docker image sets that).
JWT_SECRET=change-me-to-a-long-random-string

PAYSTACK_SECRET_KEY=
# Public URL Paystack redirects to after payment, for example
# https://your-host.example.com/payment-callback.html
PAYSTACK_CALLBACK_URL=http://localhost:8080/payment-callback.html

# Extra browser origins, comma-separated, if the site is not served by this server.
# ALLOWED_ORIGINS=https://your-frontend.example.com
# TRUSTED_PROXIES=10.0.0.0/8

PORT=8080
GIN_MODE=debug
